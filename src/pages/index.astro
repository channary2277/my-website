---
// The homepage. Each <section> below is one band of the page — ask the AI to
// add, remove, or reorder them. Every `km` field / class="km" line is the Khmer
// caption shown under the English.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getStories } from '../lib/stories';
import { site } from '../site';

const stories = getStories();
const first = stories[0];

const reasons = [
  {
    icon: '👵',
    title: 'Told for generations',
    titleKm: 'និទានតពីជំនាន់មួយទៅជំនាន់មួយ',
    text: 'Grandparents told these stories to children, long before there were books or phones.',
    textKm: 'ជីដូនជីតាបាននិទានរឿងទាំងនេះប្រាប់កូនចៅ យូរមកហើយ មុនពេលមានសៀវភៅ ឬទូរស័ព្ទ។',
  },
  {
    icon: '🧠',
    title: 'Every story has a lesson',
    titleKm: 'រឿងនីមួយៗមានមេរៀន',
    text: 'Be clever, be kind, don’t be proud. Old stories still teach us today.',
    textKm: 'ត្រូវឆ្លាត ត្រូវមានចិត្តល្អ កុំអួតខ្លួន។ រឿងចាស់ៗនៅតែបង្រៀនយើងសព្វថ្ងៃ។',
  },
  {
    icon: '👨‍👩‍👧',
    title: 'Read them together',
    titleKm: 'អានជាមួយគ្នា',
    text: 'Each story is short and simple. Read one aloud with your family tonight.',
    textKm: 'រឿងនីមួយៗខ្លី និងសាមញ្ញ។ អានមួយរឿងឱ្យឮៗជាមួយគ្រួសាររបស់អ្នកនៅយប់នេះ។',
  },
];
---

<Base>
  <Header />
  <main>
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-sun/25 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-40 size-[30rem] rounded-full bg-brand/15 blur-3xl"></div>

      <div class="relative mx-auto max-w-6xl px-4 py-16 text-center sm:px-6 sm:py-24">
        <p class="text-6xl" aria-hidden="true">📖</p>
        <h1 class="mx-auto mt-6 max-w-3xl font-display text-5xl leading-[1.05] font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl">
          Old stories from <span class="text-brand">Cambodia</span>, told again.
        </h1>
        <p lang="km" class="mt-4 text-xl text-ink/70">រឿងចាស់ៗពីប្រទេសកម្ពុជា និទានឡើងវិញ។</p>
        <p class="mx-auto mt-6 max-w-xl text-lg text-muted">
          Clever rabbits, angry giants, and magic in the sky. Short Khmer folk tales for children and families.
          <span class="km" lang="km">ទន្សាយឆ្លាត យក្សខឹង និងវេទមន្តនៅលើមេឃ។ រឿងព្រេងខ្មែរខ្លីៗសម្រាប់កុមារ និងគ្រួសារ។</span>
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="#stories" class="rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark">
            Read the stories ↓ <span lang="km" class="font-khmer font-normal opacity-80">អានរឿង</span>
          </a>
          {
            first && (
              <a href={`/stories/${first.slug}`} class="rounded-full border border-ink/15 bg-white px-6 py-3 font-semibold transition hover:border-ink/40">
                Start with {first.emoji} {first.title}
              </a>
            )
          }
        </div>
      </div>
    </section>

    <section id="stories" class="scroll-mt-20 border-t border-ink/10 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
        <p class="font-semibold text-brand">The stories <span lang="km" class="font-khmer font-normal">· រឿង</span></p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
          Choose a story.
          <span class="km" lang="km">ជ្រើសរើសរឿងមួយ។</span>
        </h2>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            stories.map((s) => (
              <a href={`/stories/${s.slug}`} class="group flex flex-col rounded-2xl border border-ink/10 bg-paper p-6 transition hover:-translate-y-1 hover:border-brand hover:shadow-xl">
                <span class="text-5xl" aria-hidden="true">{s.emoji}</span>
                <h3 class="mt-4 font-display text-2xl font-bold group-hover:text-brand">
                  {s.title}
                  {s.titleKm && <span class="km" lang="km">{s.titleKm}</span>}
                </h3>
                <p class="mt-3 text-muted">
                  {s.summary}
                  {s.summaryKm && <span class="km" lang="km">{s.summaryKm}</span>}
                </p>
                <span class="mt-auto pt-6 font-semibold text-brand">Read →</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section id="about" class="scroll-mt-20 border-t border-ink/10">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
        <p class="font-semibold text-brand">Why folk tales? <span lang="km" class="font-khmer font-normal">· ហេតុអ្វីរឿងព្រេង?</span></p>
        <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
          Stories keep our culture alive.
          <span class="km" lang="km">រឿងនិទានរក្សាវប្បធម៌របស់យើងឱ្យនៅរស់។</span>
        </h2>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {
            reasons.map((r) => (
              <div class="rounded-2xl border border-ink/10 bg-white p-6">
                <span class="text-4xl" aria-hidden="true">{r.icon}</span>
                <h3 class="mt-4 font-display text-xl font-bold">
                  {r.title}
                  <span class="km" lang="km">{r.titleKm}</span>
                </h3>
                <p class="mt-2 text-muted">
                  {r.text}
                  <span class="km" lang="km">{r.textKm}</span>
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="border-t border-ink/10 bg-ink text-paper">
      <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-balance sm:text-4xl">
          Do you know a story?
          <span class="km" lang="km">តើអ្នកស្គាល់រឿងណាមួយទេ?</span>
        </h2>
        <p class="mt-4 text-paper/70">
          Ask your grandparents for their favorite folk tale, and send it to us.
          <span class="km" lang="km">សួរជីដូនជីតារបស់អ្នកអំពីរឿងព្រេងដែលគាត់ចូលចិត្ត ហើយផ្ញើវាមកយើង។</span>
        </p>
        <a href={`mailto:${site.contactEmail}`} class="mt-8 inline-block rounded-full bg-sun px-6 py-3 font-semibold text-ink transition hover:bg-paper">
          Send a story <span lang="km" class="font-khmer font-normal">ផ្ញើរឿង</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
