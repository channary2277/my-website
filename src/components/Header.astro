---
import { site } from '../site';

const links = [
  { href: '/#stories', label: 'Stories' },
  { href: '/#about', label: 'About' },
];
---

<header class="sticky top-0 z-20 border-b border-ink/5 bg-paper/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-2 font-display text-lg font-extrabold tracking-tight">
      <span class="text-2xl" aria-hidden="true">📖</span>
      <span>{site.name} <span lang="km" class="hidden font-khmer text-sm font-normal text-muted sm:inline">{site.nameKm}</span></span>
    </a>
    <nav class="flex items-center gap-1 text-sm font-medium sm:gap-2">
      {
        links.map((l) => (
          <a href={l.href} class="hidden rounded-full px-3 py-2 text-ink/70 hover:bg-ink/5 hover:text-ink sm:inline-block">
            {l.label}
          </a>
        ))
      }
      <a href="/#stories" class="rounded-full bg-ink px-4 py-2 text-paper hover:bg-brand">Read</a>
    </nav>
  </div>
</header>
